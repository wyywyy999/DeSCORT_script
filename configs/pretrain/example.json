{
  "script": "tutorials/02_pretrain/02_pretrain_model.py",
  "launcher": [
    "{python}"
  ],
  "args": [
    "--train_dataset_path",
    "${DESCORT_DATA_ROOT}/pretrain/all_data",
    "--output_dir",
    "${DESCORT_OUTPUT_ROOT}/pretrain",
    "--do_train",
    "True",
    "--remove_unused_columns",
    "False",
    "--mlm_probability",
    "0.3",
    "--max_length",
    "1024",
    "--per_device_train_batch_size",
    "64",
    "--num_train_epochs",
    "1",
    "--learning_rate",
    "0.001",
    "--seed",
    "42",
    "--report_to",
    "none"
  ]
}
